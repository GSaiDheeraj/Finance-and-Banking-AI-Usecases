# ── LLM gateway (language layer only — never computes a number) ──────────────
LLM_ENDPOINT=https://your-gateway.example.com/
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=anthropic.claude-4-5-haiku
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── Postgres (external managed service) ─────────────────────────────────────
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=investment_research_db
PGUSER=postgres
PGPASSWORD=7194

# ── Redis (external — live job phase + optional Celery broker) ──────────────
REDISHOST=127.0.0.1
REDISPORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CELERY_REDIS_DB=1
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
USE_CELERY=0

# ── API / storage ───────────────────────────────────────────────────────────
PM_API_HOST=0.0.0.0
PM_API_PORT=8000
DATA_STORAGE_DIR=./data/uploads
PM_LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100

# ── Market data (yfinance — free, no key) ───────────────────────────────────
PM_HISTORY_PERIOD=1y

# ── Emerging-risk news scan (DuckDuckGo) ────────────────────────────────────
PM_NEWS_REGION=wt-wt
PM_NEWS_MAX_RESULTS=4
PM_NEWS_DEBUG=0
PM_NEWS_DELAY=0.5

# ── Scoring / rebalancing parameters ────────────────────────────────────────
CASHFLOW_TOLERANCE=0.10
CASHFLOW_SHORTFALL_HIGH=0.40
MATERIAL_INCOME_FLOOR=250
UNEXPECTED_FLOW_ABS=10000
TRANSACTION_COST_BPS=5

# ── Reference data overrides (optional) ─────────────────────────────────────
# IPS_TARGETS_PATH=/path/to/ips_targets.json
# RISK_LIMITS_PATH=/path/to/risk_limits.json
