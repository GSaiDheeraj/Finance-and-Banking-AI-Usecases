# ── LLM gateway ─────────────────────────────────────────────────────────────
LLM_ENDPOINT=https://your-gateway.example.com/
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=anthropic.claude-4-5-haiku

# ── Embedding model ──────────────────────────────────────────────────────────
EMBED_LLM_API_KEY=your-api-key-here
EMBED_MODEL_NAME=openai.text-embedding-3-large

# ── Scoring parameters (change without touching code) ───────────────────────
# Rating band cut-offs on the normalized 0-100 risk score.
# (Higher score = higher risk)
BAND_INVESTMENT_GRADE_STRONG_MAX=20
BAND_INVESTMENT_GRADE_MAX=40
BAND_SUB_INVESTMENT_GRADE_MAX=60
BAND_SPECULATIVE_MAX=80
# above 80 = distressed / default

# ── Reference data (point at licensed feeds in production) ──────────────────
# SECTOR_BENCHMARKS_PATH=/path/to/sector_benchmarks.json
# RATING_PD_TABLE_PATH=/path/to/pd_table.json
# INDUSTRY_LGD_TABLE_PATH=/path/to/lgd_table.json

# ── Free web-sentiment search (DuckDuckGo, no API keys) ─────────────────────
OSINT_REGION=wt-wt            # DuckDuckGo region: wt-wt (worldwide), uk-en, us-en, in-en, ...
OSINT_MAX_RESULTS=5           # results kept per query per angle
OSINT_TIMEOUT=10              # per-request timeout (seconds)
OSINT_DEBUG=1                 # 1 = print step-by-step search trace to stderr; 0 = silent

# ── Logging & data reconciliation (yfinance fallback) ───────────────────────
CREDIT_RISK_LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR
# CREDIT_RISK_LOG_FILE=credit_risk.log   # also append logs to this file
YF_DISCREPANCY_TOL=0.02       # flag doc-vs-yfinance gaps beyond this relative diff (2%)

# ── Postgres (assessment store + pgvector page index) ────────────────────────
# Point this at whichever local Postgres actually has the `vector` extension available
# and accepts these credentials — this machine has three Postgres servers installed
# (Postgres.app, and two EDB installer instances); pick the one you're actually running.
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=credit_risk
# Must match whatever EMBED_MODEL_NAME actually resolves to: 1536 for
# openai.text-embedding-3-small (config.py's default), 3072 for -large.
EMBED_DIM=1536

# ── FastAPI backend ───────────────────────────────────────────────────────────
CREDIT_RISK_API_HOST=0.0.0.0
CREDIT_RISK_API_PORT=8000
CREDIT_RISK_API_BASE_URL=http://localhost:8000   # read by the Streamlit UI
DOCUMENT_STORAGE_DIR=./data/documents            # uploaded PDFs are persisted here

# ── Redis (live job-progress tracking only — not a task queue/broker) ───────
# Optional: if unreachable, status_tracker.py degrades to reporting Postgres's coarser
# status instead of live phase updates. No assessment ever fails because Redis is down.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
