# OpenAI-compatible gateway (the underlying model may be Claude / OSS / Azure).
LLM_ENDPOINT=https://your-gateway.example.com/
LLM_API_KEY=replace-me
LLM_MODEL_NAME=anthropic.claude-4-5-haiku

# Embeddings (defaults to LLM_API_KEY if omitted)
EMBED_LLM_API_KEY=replace-me
EMBED_MODEL_NAME=openai.text-embedding-3-large
EMBED_DIM=1536

# Generation controls (onboarding decisions must stay deterministic)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Database configuration (PostgreSQL)
PGHOST=localhost
PGPORT=5433
PGDATABASE=fraud_detection_db
PGUSER=postgres
PGPASSWORD=7194

# Redis configuration (for job status tracking)
REDISHOST=localhost
REDISPORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application configuration
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100
DOCUMENT_STORAGE_DIR=./data/uploads

# Beneficial-ownership threshold (% effective ownership at/above which a person is a UBO)
UBO_THRESHOLD_PCT=25.0

# Optional: point reference feeds at licensed lists (JSON files); falls back to bundled samples.
# PEP_LIST_PATH=/data/feeds/pep.json
# SANCTIONS_LIST_PATH=/data/feeds/sanctions.json
# ADVERSE_MEDIA_PATH=/data/feeds/adverse_media.json
# HIGH_RISK_JURISDICTIONS_PATH=/data/feeds/high_risk_jurisdictions.json

# --- Name-driven OSINT flow (free web search; no keys needed) ---
OSINT_MAX_RESULTS=5        # results kept per search query
OSINT_TIMEOUT=10          # seconds before a page fetch / search gives up
OSINT_REGION=wt-wt        # DuckDuckGo region (wt-wt = worldwide)
OSINT_COUNTRY=in          # Google region: 2-letter country code (in=India, us=USA); blank = no preference
